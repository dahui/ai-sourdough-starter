#!/usr/bin/env bash
# sync-profiles — propagate universal files from the starter root (and
# profiles/_common/) into each profile's template/ tree.
#
# Universal files are those that are identical across all profiles by
# design: hook scripts, slash commands, .clinerules addenda, ADR seed,
# plan templates, editor configs, the conditionally-rendered LICENSE.
#
# Profile-specific files (AGENTS.md §11, CLAUDE.md, README, .gitignore,
# .github/workflows/*, source code) are NOT touched.
#
# Usage:
#   bin/sync-profiles           # write changes; print one line per file
#   bin/sync-profiles --check   # exit non-zero if any sync would write;
#                               # used by CI to gate commits
#
# Run AFTER bin/sync-commands. The .claude/commands/ and
# .clinerules/workflows/ trees are regenerated by sync-commands; this
# tool propagates the regenerated trees into each profile.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CHECK_MODE=0
case "${1:-}" in
  --check) CHECK_MODE=1 ;;
  "") ;;
  *) echo "sync-profiles: unknown argument: $1" >&2; exit 2 ;;
esac

PROFILES=(go java nodejs-ts python)
changes=0
errors=0

# Single-file copy: sync $1 into $2 if they differ. Tracks changes count.
sync_file() {
  local src="$1"
  local dst="$2"
  if [[ ! -f "$src" ]]; then
    echo "sync-profiles: missing canonical source: $src" >&2
    errors=$((errors + 1))
    return
  fi
  if cmp -s "$src" "$dst" 2>/dev/null; then
    return  # already in sync
  fi
  if [[ "$CHECK_MODE" -eq 1 ]]; then
    echo "DRIFT: $(realpath --relative-to="$REPO_ROOT" "$dst" 2>/dev/null || echo "$dst")"
  else
    mkdir -p "$(dirname "$dst")"
    cp -p "$src" "$dst"
    echo "synced: $(realpath --relative-to="$REPO_ROOT" "$dst" 2>/dev/null || echo "$dst")"
  fi
  changes=$((changes + 1))
}

# Sync all files (recursive) from $1 to <profile-template>/$2 for every
# profile. Preserves directory structure under the source. Additional
# args are glob patterns (relative path under src_root) to skip — used
# to exclude per-user override files like .claude/settings.local.json.
sync_tree() {
  local src_root="$1"
  local dst_rel="$2"
  shift 2
  local skip_patterns=("$@")
  if [[ ! -d "$src_root" ]]; then
    echo "sync-profiles: missing canonical source directory: $src_root" >&2
    errors=$((errors + 1))
    return
  fi
  for prof in "${PROFILES[@]}"; do
    local dst_root="$REPO_ROOT/profiles/$prof/template/$dst_rel"
    while IFS= read -r -d '' file; do
      local rel="${file#"$src_root"/}"
      local skip=0
      if [[ ${#skip_patterns[@]} -gt 0 ]]; then
        for pat in "${skip_patterns[@]}"; do
          # shellcheck disable=SC2053
          if [[ "$rel" == $pat ]]; then skip=1; break; fi
        done
      fi
      [[ "$skip" -eq 1 ]] && continue
      sync_file "$file" "$dst_root/$rel"
    done < <(find "$src_root" -type f -print0)
  done
}

# Sync a single file to <profile-template>/$2 for every profile.
sync_to_each() {
  local src="$1"
  local dst_rel="$2"
  for prof in "${PROFILES[@]}"; do
    sync_file "$src" "$REPO_ROOT/profiles/$prof/template/$dst_rel"
  done
}

# ---------- Canonical sources at the starter root ----------

# .claude/ tree — settings, hooks, agents, commands (commands include
# .synced.sha256 sidecars from bin/sync-commands; those get propagated too).
# Skip settings.local.json: Claude Code's per-user override file, contains
# local paths and permission grants that must NOT be distributed.
sync_tree "$REPO_ROOT/.claude" ".claude" "settings.local.json"

# .clinerules/ tree — cline addenda + workflows (with sidecars)
sync_tree "$REPO_ROOT/.clinerules" ".clinerules"

# ---------- Canonical sources in profiles/_common/ ----------

sync_to_each "$REPO_ROOT/profiles/_common/docs/adr/0000-record-architecture-decisions.md" \
             "docs/adr/0000-record-architecture-decisions.md"

sync_to_each "$REPO_ROOT/profiles/_common/plans/_template.md" \
             "plans/_template.md"

sync_to_each "$REPO_ROOT/profiles/_common/plans/README.md" \
             "plans/README.md"

sync_to_each "$REPO_ROOT/profiles/_common/.gitattributes" \
             ".gitattributes"

sync_to_each "$REPO_ROOT/profiles/_common/.editorconfig" \
             ".editorconfig"

# Note: source filename has .base suffix (a template indicator at the
# starter level); destination is the unsuffixed name pre-commit expects.
sync_to_each "$REPO_ROOT/profiles/_common/.pre-commit-config.yaml.base" \
             ".pre-commit-config.yaml"

# ---------- Canonical LICENSE ----------
# The conditionally-Jinja-rendered LICENSE template is identical across
# all four profiles by design (handles MIT/Apache-2.0/none branches with
# {{ copyright_holder }}). Canonical source is Go's copy — first profile
# built. Propagated to the other three. (Future cleanup: move canonical
# into profiles/_common/.)
for prof in java nodejs-ts python; do
  sync_file "$REPO_ROOT/profiles/go/template/LICENSE" \
            "$REPO_ROOT/profiles/$prof/template/LICENSE"
done

# ---------- Summary / exit ----------

if [[ "$errors" -gt 0 ]]; then
  echo "" >&2
  echo "sync-profiles: $errors error(s) above." >&2
  exit 2
fi

if [[ "$CHECK_MODE" -eq 1 ]]; then
  if [[ "$changes" -gt 0 ]]; then
    echo "" >&2
    echo "sync-profiles --check: $changes file(s) would change. Run bin/sync-profiles to apply." >&2
    exit 1
  fi
  echo "sync-profiles --check: all profile files in sync."
  exit 0
fi

if [[ "$changes" -eq 0 ]]; then
  echo "sync-profiles: all profile files already in sync."
else
  echo ""
  echo "sync-profiles: $changes file(s) synced across ${#PROFILES[@]} profile(s)."
fi
